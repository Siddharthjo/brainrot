# Brainrot .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
/logs/
celery/logs/

# Database
*.db
*.sqlite
*.sqlite3

# Cache
.cache/
*.cache

# OS
.DS_Store
Thumbs.db

# Project specific
uploads/
generated_videos/
.tmp/

# Local storage (storage/README.md explains why) — keep folders, ignore contents
storage/temp/*
storage/cache/*
storage/generated/*
storage/logs/*
!storage/temp/.gitkeep
!storage/cache/.gitkeep
!storage/generated/.gitkeep
!storage/logs/.gitkeep
