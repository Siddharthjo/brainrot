# Brainrot Environment Variables
# Copy this to .env and fill in your values

# ─────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────

ENV=development
DEBUG=true
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/brainrot
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/brainrot_test

# ─────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────

SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─────────────────────────────────────────────────────────
# LLM Providers
# ─────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...
CLAUDE_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Default LLM for different tasks
LLM_RESEARCH=openai  # openai, claude, gemini
LLM_SCRIPT=openai
LLM_REVIEW=claude
LLM_IMAGES=gemini

# ─────────────────────────────────────────────────────────
# Storage (Cloudflare R2)
# ─────────────────────────────────────────────────────────

R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=brainrot
R2_REGION=auto

# ─────────────────────────────────────────────────────────
# Video Generation (To be determined in M0)
# ─────────────────────────────────────────────────────────

VIDEO_PROVIDER=storyshort  # storyshort, autoshorts, creatomate, etc
VIDEO_PROVIDER_API_KEY=...

# ─────────────────────────────────────────────────────────
# Voice Generation
# ─────────────────────────────────────────────────────────

VOICE_PROVIDER=elevenlabs  # elevenlabs, google_tts, cartesia
ELEVENLABS_API_KEY=...
ELEVENLABS_DEFAULT_VOICE_ID=...

GOOGLE_TTS_CREDENTIALS=...  # Path to Google Cloud credentials JSON

CARTESIA_API_KEY=...

# ─────────────────────────────────────────────────────────
# Social Platform APIs
# ─────────────────────────────────────────────────────────

# YouTube
YOUTUBE_API_KEY=...
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...

# Instagram / Meta
META_ACCESS_TOKEN=...
META_BUSINESS_ACCOUNT_ID=...
META_APP_ID=...
META_APP_SECRET=...

# ─────────────────────────────────────────────────────────
# Research Sources
# ─────────────────────────────────────────────────────────

# Reddit
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=Brainrot/1.0

# Twitter/X
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_BEARER_TOKEN=...

# News API
NEWS_API_KEY=...

# ─────────────────────────────────────────────────────────
# Monitoring & Logging
# ─────────────────────────────────────────────────────────

SENTRY_DSN=  # Optional error tracking
LOG_TO_FILE=true
LOG_FILE_PATH=logs/brainrot.log

# ─────────────────────────────────────────────────────────
# Development Only
# ─────────────────────────────────────────────────────────

BACKEND_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────
# Frontend (React)
# ─────────────────────────────────────────────────────────

REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_WS_URL=ws://localhost:8000/ws
